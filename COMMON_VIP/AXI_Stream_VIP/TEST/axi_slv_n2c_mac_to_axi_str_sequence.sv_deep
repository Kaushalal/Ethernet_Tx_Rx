`ifndef N2C_MAC_TO_AXI_STR_SEQUENCE_SV
`define N2C_MAC_TO_AXI_STR_SEQUENCE_SV

class n2c_mac_to_axi_str_sequence extends axi_str_mas_base_seqs; 
 
  `uvm_object_utils(n2c_mac_to_axi_str_sequence) 
   
   uvm_sequencer #(n2c_mac_lyr_seq_item) up_seqr_n2c;
   axi_str_mas_seq_item #(.DATA_SIZE(`DATA_WIDTH),.USER_SIZE(`USER_WIDTH)) req;
   n2c_mac_lyr_seq_item n2c_seq_item;

    //-------------------------------------------------------------------------------- 
     // Method : 
      
       // Arguments : 
        
         // Description : 
          
           //--------------------------------------------------------------------------------- 
   function new (string name="n2c_mac_to_axi_str_sequence"); 
      super.new(name); 
   endfunction: new 
   
   function void build_phase(uvm_phase phase);
      n2c_seq_item = n2c_mac_lyr_seq_item ::type_id::create("n2c_seq_item");
   endfunction : build_phase

  bit [`DATA_WIDTH-1:0] data_q [$];
  int data_qsize;
   task body();
    forever begin
      up_seqr_n2c.get_next_item(n2c_seq_item);
        req = axi_str_mas_seq_item #(.DATA_SIZE(`DATA_WIDTH),.USER_SIZE(`USER_WIDTH)) ::type_id::create("req");
        start_item(req);
          //$display("n2c mac layer trans");
          `uvm_info("n2c_mac_seq_item",$sformatf("n2c_mac_seq_item  in n2c_mac to axi_str_sequence : %0s",n2c_seq_item.sprint()),UVM_DEBUG)

//client encrypted pkt   162        
//data_q[0] = 512'h216b4be444bdad2af0496facac94f4ff107788d47a0eb620a17677937800000000000000000000000100056000000081f003b588111144443333555588887777;
//data_q[1] = 512'he3b2acf3eb069718f13abc4fdc2c18252376a8fa9e02eb8413c355056d6198a021335f6d5fb34daf07239e6240d8eebcf52cf9366d40a01749968b912e80dffc;
//data_q[2] = 512'haefaf1bda5de79de45ba6ea72abece86683d21b80c8f29e90f8d24bd0daedca8d8be;

//cpu_port_1
//data_q[0] = 512'h8d84b885dd956fdff6815c687350cb285b68d785046b206c1df208703400000000000000000000000100051000000081f003b588111144443333555588887777; //for check header 515253545556
//data_q[1] = 512'hb460289fb5ac0188751cc1e726b0f9bf995c2507d0133b78e86d48ba36a3b7aff537be8f3e1666d629377;

//cpu_port_1 
//data_q[0] = 512'h8d84b885dd956fdff6815c687350cb285b68d785046b206c1df208703400000000000000000000000100051000000081f003b5881111222266665555dddd9999;
//data_q[1] = 512'hb460289fb5ac0188751cc1e726b0f9bf995c2507d0133b78e86d48ba36a3b7aff537be8f3e1666d629377;  //le: 107

//cpu encrypted data 129 key 1111222233334444555666777888
//data_q[0] = 512'h5fad08dcfe57ac9d841fe8a7ea1b9841c1745ce5e08412e11803d0ad1500000000000000000000000100050000000081f003b588111144443333555588887777;
//data_q[1] = 512'hd6158698ce8e6b0198bb39172a56f29f945beaa7ca284b4b57f9b7e8c5ae14f23e771c749bd50ef930bc102532d4f7d76f629eb8ab8eb7a0ddf309a5b45cc10;
//data_q[2] = 512'hae;
          mac_to_axi_conv();
          `ifdef NO_GCM
	      data_qsize = (($size(n2c_seq_item.dst_addr)+$size(n2c_seq_item.src_addr)+$size(n2c_seq_item.outer_e_type)+$size(n2c_seq_item.VLAN)+$size(n2c_seq_item.inner_e_type)+$size(n2c_seq_item.cypher_hdr_key_id)+$size(n2c_seq_item.key_sel_bc_key)+$size(n2c_seq_item.message_bit)+$size(n2c_seq_item.evc_id)+$size(n2c_seq_item.iv))/8);
          `else    
	      data_qsize = (($size(n2c_seq_item.dst_addr)+$size(n2c_seq_item.src_addr)+$size(n2c_seq_item.outer_e_type)+$size(n2c_seq_item.VLAN)+$size(n2c_seq_item.inner_e_type)+$size(n2c_seq_item.cypher_hdr_key_id)+$size(n2c_seq_item.key_sel_bc_key)+$size(n2c_seq_item.message_bit)+$size(n2c_seq_item.evc_id)+$size(n2c_seq_item.iv)+$size(n2c_seq_item.gcm_signature))/8);
          `endif
          data_qsize = data_qsize + $size(n2c_seq_item.payload_q);
          //foreach(data_q[i]) $display("data que of %0d = %0h",i,data_q[i]);
          `uvm_info("n2c_mac_axi_str_seq",$sformatf("size of data_q bytes = %0d | size_of_data_q = %0d ",data_qsize,data_q.size()),UVM_DEBUG)
          if(!req.randomize() with {tuser == n2c_seq_item.side_band_data; total_bytes == data_qsize; foreach(data_q[i]) {tdata_q[i] == data_q[i];}})
              `uvm_error("n2c_mac_to_axi_mas_str", "randomize failed of n2c mac ")
           //`uvm_do_with(req, {tuser == n2c_seq_item.side_band_data; total_bytes == data_qsize; foreach(data_q[i]) {tdata_q[i] == data_q[i];}})
          `uvm_info("n2c_mac_axi_str_seq",$sformatf("size of data_q bytes = %0d | size_of_data_q = %0d | size of tdata_q = %0d",data_qsize,data_q.size(),req.tdata_q.size()),UVM_DEBUG)
        finish_item(req);
      up_seqr_n2c.item_done();
     end
   endtask : body
   function void mac_to_axi_conv();
    `ifdef NO_GCM 
       data_q = {<<8{n2c_seq_item.payload_q, n2c_seq_item.iv, n2c_seq_item.evc_id, n2c_seq_item.message_bit, n2c_seq_item.key_sel_bc_key, n2c_seq_item.cypher_hdr_key_id, n2c_seq_item.inner_e_type, n2c_seq_item.VLAN, n2c_seq_item.outer_e_type, n2c_seq_item.src_addr, n2c_seq_item.dst_addr}};
    `else
       data_q = {<<8{n2c_seq_item.gcm_signature, n2c_seq_item.payload_q, n2c_seq_item.iv, n2c_seq_item.evc_id, n2c_seq_item.message_bit, n2c_seq_item.key_sel_bc_key, n2c_seq_item.cypher_hdr_key_id, n2c_seq_item.inner_e_type, n2c_seq_item.VLAN, n2c_seq_item.outer_e_type, n2c_seq_item.src_addr, n2c_seq_item.dst_addr}};
    `endif
     foreach(data_q[i]) `uvm_info("axi_str_mas_seqs",$sformatf("before reverse actual data que : %h",data_q[i]),UVM_DEBUG);
     foreach(data_q[i]) data_q[i] = {<<8{data_q[i]}}; 
     foreach(data_q[i]) `uvm_info("axi_str_mas_seqs",$sformatf("actual data que : %h",data_q[i]),UVM_DEBUG);
  endfunction   
endclass : n2c_mac_to_axi_str_sequence

`endif
       //data_q = {<<8{/*n2c_seq_item.gcm_signature*/, n2c_seq_item.payload_q, n2c_seq_item.iv, n2c_seq_item.evc_id, n2c_seq_item.message_bit, n2c_seq_item.key_sel_bc_key, n2c_seq_item.cypher_hdr_key_id, n2c_seq_item.inner_e_type, n2c_seq_item.VLAN, n2c_seq_item.outer_e_type, n2c_seq_item.src_addr, n2c_seq_item.dst_addr}};
     
       //data_q = {>>{n2c_seq_item.dst_addr,n2c_seq_item.src_addr,n2c_seq_item.outer_e_type,n2c_seq_item.VLAN,n2c_seq_item.inner_e_type,n2c_seq_item.cypher_hdr_key_id,n2c_seq_item.key_sel_bc_key,n2c_seq_item.message_bit,n2c_seq_item.evc_id,n2c_seq_item.iv,n2c_seq_item.payload_q,n2c_seq_item.gcm_signature}};
	     // data_qsize = (($size(n2c_seq_item.dst_addr)+$size(n2c_seq_item.src_addr)+$size(n2c_seq_item.outer_e_type)+$size(n2c_seq_item.VLAN)+$size(n2c_seq_item.inner_e_type)+$size(n2c_seq_item.cypher_hdr_key_id)+$size(n2c_seq_item.key_sel_bc_key)+$size(n2c_seq_item.message_bit)+$size(n2c_seq_item.evc_id)+$size(n2c_seq_item.iv)+$size(n2c_seq_item.gcm_signature))/8) + ($size(n2c_seq_item.payload_q));
