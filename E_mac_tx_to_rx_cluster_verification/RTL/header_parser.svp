/*
module header_parser#(
  int DATA_SIZE = 32,
  int ADDR_SIZE = 32,  // for 32K registers (2^15)
  int ID_SIZE   = 32,
  int AXIS_DATA_SIZE = 32,
  int USER_SIZE = 16    
)(
   logic reg_clk,
   logic clk_n,
   logic reset_reg,
   logic reset_n,
  axi_lite_inf.slave axil_inf,
  axi_str_slave_inf.slave  axis_in_inf,
  axi_str_master_inf.master axis_out_inf
  
);
`pragma protect begin
  // ---------------- Memory Declarations ----------------
  bit [DATA_SIZE-1:0] connection_config_mem [0:32767];
  bit [DATA_SIZE-1:0] output_port           [0:31];
  bit [DATA_SIZE-1:0] crc_mem               [0:31];
  bit [DATA_SIZE-1:0] vcd_reg               [0:31]; // vcd_id register 

  bit [ADDR_SIZE-1:0] awaddr;
  bit [ID_SIZE-1:0] awid;
  bit [ID_SIZE-1:0] arid;
  bit [DATA_SIZE-1:0] rdata;
  bit [1:0] bresp;
  bit [1:0] rresp;

  int valid_reg_count; //counter for indetifie all required register written
  // ---------------- Write Logic ----------------
  always @(posedge reg_clk) begin
    if (!reset_reg) begin
      axil_inf.awready <= 1'b0;
      axil_inf.wready  <= 1'b0;
      axil_inf.bvalid  <= 1'b0;
    end
    else begin
      axil_inf.awready <= 1'b1;
      axil_inf.wready  <= 1'b1;
      axil_inf.bvalid <= 1'b0;
      fork
        @(posedge reg_clk iff axil_inf.awvalid);
		if(!axil_inf.awready) begin
		  @(posedge reg_clk iff axil_inf.awready);
		end
        @(posedge reg_clk iff axil_inf.wvalid);
		if(!axil_inf.wready) begin
		  @(posedge reg_clk iff axil_inf.wready);
		end
	  join_any
	  awaddr = axil_inf.awaddr;
	  awid = axil_inf.awid;
	  wait fork;
        axil_inf.bid    <= awid;
        axil_inf.bvalid <= 1'b1;

        // -------- Address Decode --------
      if(awaddr inside {[3000:3099]}) begin
         output_port[awaddr[4:0]-15'h3000] <= axil_inf.wdata;
         bresp  <= 2'b00;
         valid_reg_count++;
      end
      else if(awaddr inside {[3100:3999]}) begin
         crc_mem[axil_inf.awaddr[4:0]-15'h3100] <= axil_inf.wdata;
         bresp  <= 2'b00;
         valid_reg_count++;
      end
      else if(awaddr inside {[4000:36768]}) begin
         connection_config_mem[axil_inf.awaddr[16:0]-15'h4000] <= axil_inf.wdata;
         bresp  <= 2'b00;		
         valid_reg_count++;
      end
      else if(awaddr inside {[2900:2929]}) begin
	 vcd_reg[axil_inf.awaddr[4:0]-15'h2900] <= axil_inf.wdata;
	 bresp <= 2'b00;
	 valid_reg_count++;
      end
      else begin
         bresp <= 2'b10;
      end
      @(posedge reg_clk iff axil_inf.bready);
      axil_inf.bvalid <= 1'b0;
    end
  end

  // ---------------- Read Logic ----------------
  always @(posedge reg_clk) begin
    if (!reset_reg) begin
      axil_inf.arready <= 1'b0;
      axil_inf.rvalid  <= 1'b0;
    end
    else begin
      axil_inf.arready <= 1'b1;
      axil_inf.rvalid <= 1'b0;
      fork
        @(posedge reg_clk iff axil_inf.arvalid);
        if(!axil_inf.arready) begin
          @(posedge reg_clk iff axil_inf.arready);
        end
      join

      // -------- Address Decode --------
      if(axil_inf.araddr inside {[3000:3099]}) begin
          rdata <= output_port[axil_inf.araddr[4:0]-15'h3000];
          rresp <= 2'b00;
      end
      else if(axil_inf.araddr inside {[3100:3999]}) begin
          rdata <= crc_mem[axil_inf.araddr[4:0]-15'h3100];
          rresp <= 2'b00;
      end
      else if(axil_inf.araddr inside {[4000:36768]}) begin
          rdata <= connection_config_mem[axil_inf.araddr[16:0]-15'h4000];
          rresp <= 2'b00;		
      end
      else if(axil_inf.araddr inside {[2900:2929]})  begin
	  rdata <= vcd_reg[axil_inf.araddr[4:0]-15'h2900];
	  rresp <= 2'b00;
      end
      else begin
          rdata <= 0;
          rresp <= 2'b10;
      end
      axil_inf.rdata  <= rdata;
      axil_inf.rid    <= arid;		
      axil_inf.rvalid <= 1'b1;
      axil_inf.rresp  <= rresp;
      axil_inf.rlast  <= 1'b1;
      @(posedge reg_clk iff axil_inf.rready);
      axil_inf.rvalid <= 1'b0;
      axil_inf.rlast  <= 1'b0;
    end
  end
  int valid_counter;
  int invalid_counter;
  localparam SRC_ADDR_WIDTH = 48, DST_ADDR_WIDTH = 48;
  bit [7:0]vcd_id;  // vcd_id read from vcd_reg
// ---------------- AXI-Stream Packet Capture ---------------- 
  always@(posedge clk_n) begin
      if(!reset_n) begin
	    //counter;
	    valid_counter <=0;
	    invalid_counter <=0;
      end
      else begin
          wait(valid_reg_count == 3); //wait for all required register written  
          valid_reg_count = 0; 
         // make_packet();
          header_parser();
	      drive_packet();
      end
  end

  // Queues
  logic [AXIS_DATA_SIZE-1:0] axis_pkt_temp_tdata_q[3][][$];
  logic [(AXIS_DATA_SIZE/8)-1:0] axis_pkt_temp_tkeep_q[3][][$];
  logic [USER_SIZE-1:0]      axis_pkt_temp_tuser_q[$];

  //valid packet queue
  logic [AXIS_DATA_SIZE-1:0] axis_session_valid_pkt_tdata_q[$][$];
  logic [(AXIS_DATA_SIZE/8)-1:0] axis_session_valid_pkt_tkeep_q[$][$];
  logic [USER_SIZE-1:0]      axis_session_valid_pkt_tuser_q[$];
  int valid_pkt_num =0;
  int invalid_session_pkt_num;

// Step 1: make_packet()
 // task make_packet();
    int pkt_num; 
  initial begin
   forever begin 
    @(posedge clk_n iff axis_in_inf.tvalid);
    if(!axis_in_inf.tready == 1'b0) begin
          @(posedge clk_n iff axis_in_inf.tready);
    end
    axis_pkt_temp_tdata_q[pkt_num][0].push_back(axis_in_inf.tdata);
    axis_pkt_temp_tkeep_q[pkt_num][0].push_back(axis_in_inf.tkeep);
    axis_pkt_temp_tuser_q.push_back(axis_in_inf.tuser); // todo
   $display("make packet for parser : %p",axis_pkt_temp_tdata_q[pkt_num][0].size());

    if (axis_in_inf.tlast) begin
          @(posedge clk_n);
	      pkt_num++;
          //$display("[%0t] Packet captured from port %0d, size=%0d", $time, i, axis_pkt_temp_tdata_q[i].size());
    end
end //initial
end  //forever 
  //endtask : make_packet

//step 2
  task header_parser;
      int i,j;
       //check interface axi stream
       //read memory (register)
       //check packet is valid or not
      bit [USER_SIZE-1:0] index;
      bit [DATA_SIZE-1:0] expected_connection;
      bit [DATA_SIZE-1:0] expected_output;
      bit [DATA_SIZE-1:0] expected_crc;
      connection_addr_t connection_addr;
      logic [AXIS_DATA_SIZE-1:0] tdata_packet[$];
      logic [USER_SIZE-1:0]      tuser_packet;
  
      wait(axis_pkt_temp_tdata_q[0][0].size() != 0);
      $display($time, "[HEADER_PARSER] axis_pkt_temp_tdata_q have some data");
      foreach (axis_pkt_temp_tdata_q[0][i]) begin
          tuser_packet = axis_pkt_temp_tuser_q.pop_front();
          $display($time,"[HEADER_PARSER]tuser_packet = %h",tuser_packet);
          // Extract VLAN and Port
          connection_addr.vlan_id    = {tuser_packet[USER_SIZE-4 : 4],tuser_packet[USER_SIZE-1 : USER_SIZE-3]};
          $display($time,"[HEADER_PARSER]connection_addr.vlan_id = %h",connection_addr.vlan_id );
          connection_addr.port_id = tuser_packet[3:0];
          $display($time,"[HEADER_PARSER]connection_addr.port_id = %h",connection_addr.port_id);
         vcd_id = vcd_reg[connection_addr.port_id[7:0]]; //
          $display($time,"[HEADER_PARSER]vcd_id = %h",vcd_id);
         axis_session_valid_pkt_tuser_q.push_back({8'h00,vcd_id});
          
          index = {connection_addr.port_id,connection_addr.vlan_id};
          
          $display($time,"[HEADER_PARSER]index = %h",index);
          expected_connection = connection_config_mem[index];
          if(expected_connection[7] == 1'b1)begin
            $display($time,"[HEADER_PARSER] expected_connection[7] == 1'b1 PASS!! " );
          expected_output     = output_port[connection_addr.port_id];
          expected_crc        = crc_mem[connection_addr.port_id];            // Check packet against memories
             if(axis_pkt_temp_tdata_q[i][j][((SRC_ADDR_WIDTH + DST_ADDR_WIDTH)/32)][12:0] == expected_connection) begin
                $display($time,"[HEADER_PARSER] axis_pkt_temp_tdata_q[i][((SRC_ADDR_WIDTH + DST_ADDR_WIDTH)/32)][12:0] == expected_connection PASS!! " );
                foreach(tdata_packet[i][j]) begin 
                   axis_session_valid_pkt_tdata_q[valid_pkt_num].push_back(axis_pkt_temp_tdata_q[0][i][j]);
                   axis_session_valid_pkt_tkeep_q[valid_pkt_num].push_back(axis_pkt_temp_tdata_q[0][i][j]);
                   axis_session_valid_pkt_tuser_q.push_back(tuser_packet);
                   $dsipaly($time,"axis_session_valid_pkt_tdata_q[%d] = %h",valid_pkt_num,axis_session_valid_pkt_tdata_q[valid_pkt_num][0]);
                   $dsipaly($time,"axis_session_valid_pkt_tkeep_q[%d] = %h",valid_pkt_num,axis_session_valid_pkt_tkeep_q[valid_pkt_num][0]);
                end
                valid_pkt_num++;
                axis_pkt_temp_tdata_q[0][i].delete(i);
                axis_pkt_temp_tkeep_q[0][i].delete(i);
          //      $display("[%0t] PACKET VALID: port=%0d vlan_id=%0d data=0x%0h", $time, connection_addr.port_id, connection_addr.vlan_id, tdata_packet);
             end
             else begin

                $display($time,"[HEADER_PARSER] axis_pkt_temp_tdata_q[i][((SRC_ADDR_WIDTH + DST_ADDR_WIDTH)/32)][12:0] == expected_connection FAILED!! " );
                axis_pkt_temp_tdata_q[0][i].delete(i);
                axis_pkt_temp_tkeep_q[0][i].delete(i);
             end
          end 
          else begin
            $display($time,"[HEADER_PARSER] expected_connection[7] == 1'b1  FAILED!! " );
             axis_pkt_temp_tdata_q[0][i].delete(i);
             axis_pkt_temp_tkeep_q[0][i].delete(i);
             invalid_session_pkt_num++;
             //$display("[%0t] PACKET INVALID: port=%0d vlan_id=%0d data=0x%0h | expected_connection=0x%0h expected_output=0x%0h expected_crc=0x%0h", $time, connection_addr.port_id, connection_addr.vlan_id,tdata_packet, expected_connection, expected_output, expected_crc);
          end
      end
endtask : header_parser 

task drive_packet();
 int i,j;
 logic [(DATA_SIZE-1):0] axis_tdata_q[$];
 logic [((DATA_SIZE/8)-1):0] axis_tkeep_q[$];  
 logic [USER_SIZE-1:0] tuser_local_q[$];
 wait(axis_session_valid_pkt_tdata_q.size() != 0);
  
 //make packet 
 foreach(axis_session_valid_pkt_tdata_q[i][j]) begin
   axis_out_inf.tvalid = 1'b1;
   axis_out_inf.tuser = axis_session_valid_pkt_tuser_q.pop_front();
   axis_out_inf.tdata = axis_session_valid_pkt_tdata_q[i][j];
   axis_out_inf.tkeep = axis_session_valid_pkt_tdata_q[i][j];
   axis_out_inf.tlast = 1'b0;
   if(j == axis_session_valid_pkt_tdata_q[i].size()-1) begin
        axis_out_inf.tlast = 1'b1;
        @(posedge clk_n);
   end
   @(posedge clk_n iff axis_out_inf.tready);
   axis_out_inf.tvalid = 1'b0;
   axis_session_valid_pkt_tdata_q.delete(i);
   axis_session_valid_pkt_tkeep_q.delete(i);
 end
endtask : drive_packet 
endmodule
`pragma protect end*/


module header_parser#(
  int DATA_SIZE = 32,
  int ADDR_SIZE = 32,  // for 32K registers (2^15)
  int ID_SIZE   = 32,
  int AXIS_DATA_SIZE = 32,
  int USER_SIZE = 16    
)(
   logic reg_clk,
   logic clk_n,
   logic reset_reg,
   logic reset_n,
  axi_lite_inf.slave axil_inf,
  axi_str_slave_inf.slave  axis_in_inf,
  axi_str_master_inf.master axis_out_inf
  
);
`pragma protect begin_protected
`pragma protect version = 1
`pragma protect encrypt_agent = "QuestaSim" , encrypt_agent_info = "2023.4"
`pragma protect key_keyowner = "Siemens" , key_keyname = "SIEMENS-VERIF-SIM-RSA-2"
`pragma protect key_method = "rsa"
`pragma protect encoding = ( enctype = "base64" , line_length = 64 , bytes = 256 )
